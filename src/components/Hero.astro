---
import HeroCanvas from './HeroCanvas.astro'
---

<nav data-nav>
  <span class="nav-logo">Achu</span>
  <div class="nav-links">
    <a href="https://github.com/achu" target="_blank" rel="noopener">GitHub</a>
    <a href="https://t.me/achu" target="_blank" rel="noopener">Telegram</a>
  </div>
</nav>

<section class="hero">
  <HeroCanvas />
  <div class="hero-content">
    <h1 class="hero-name" data-hero-title>I'm <span class="accent">Achu</span></h1>
    <p class="hero-tagline" data-hero-tagline>
      ROM developer for violet.<span class="cursor" data-hero-cursor>_</span>
    </p>
  </div>
  <div class="hero-bottom" data-hero-scroll>
    <div class="hero-rule"></div>
    <span class="scroll-arrow">&darr;</span>
  </div>
</section>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2.5rem;
    z-index: 100;
    background: linear-gradient(180deg, var(--bg-primary) 0%, transparent 100%);
  }

  .nav-logo {
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 6vw;
    overflow: hidden;
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 600px;
  }

  .hero-tagline {
    margin-top: 1.5rem;
    letter-spacing: 0.02em;
  }

  .cursor {
    color: var(--accent);
    animation: blink 1s step-end infinite;
    font-weight: 700;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .hero-bottom {
    position: absolute;
    bottom: 2.5rem;
    left: 2.5rem;
    right: 2.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    z-index: 2;
  }

  .hero-rule {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .scroll-arrow {
    color: var(--text-secondary);
    animation: bob 2s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  @media (max-width: 768px) {
    nav {
      padding: 1rem 1.25rem;
    }

    .hero {
      padding: 0 5vw;
    }

    .hero-content {
      max-width: 100%;
    }

    .hero-name {
      white-space: normal;
      word-break: break-word;
    }

    .hero-bottom {
      left: 1.25rem;
      right: 1.25rem;
      bottom: 1.25rem;
    }
  }
</style>
