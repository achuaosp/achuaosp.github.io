---
import HeroCanvas from './HeroCanvas.astro'
---

<nav data-nav>
  <span class="nav-logo">Achu</span>
  <div class="nav-links">
    <a href="https://github.com/achu" target="_blank" rel="noopener">GitHub</a>
    <a href="https://t.me/achu" target="_blank" rel="noopener">Telegram</a>
  </div>
</nav>

<section class="hero">
  <HeroCanvas />
  <div class="hero-content">
    <h1 class="hero-title" data-hero-title>I'm Achu</h1>
    <p class="hero-tagline" data-hero-tagline>
      ROM developer for violet.<span class="cursor" data-hero-cursor>_</span>
    </p>
  </div>
  <div class="hero-bottom" data-hero-scroll>
    <div class="hero-rule"></div>
    <span class="scroll-arrow">&darr;</span>
  </div>
</section>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2.5rem;
    z-index: 100;
    background: linear-gradient(180deg, var(--bg-primary) 0%, transparent 100%);
  }

  .nav-logo {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-links a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    transition: color 0.25s var(--ease-out);
  }

  .nav-links a:hover {
    color: var(--accent);
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: 100vh;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-left: 8vw;
  }

  .hero-title {
    font-family: var(--font-mono);
    font-size: clamp(3.5rem, 10vw, 8rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .hero-tagline {
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 2vw, 1.25rem);
    font-weight: 400;
    color: var(--text-secondary);
    margin-top: 1.5rem;
    letter-spacing: 0.02em;
  }

  .cursor {
    color: var(--accent);
    animation: blink 1s step-end infinite;
    font-weight: 700;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .hero-bottom {
    position: absolute;
    bottom: 2.5rem;
    left: 2.5rem;
    right: 2.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    z-index: 2;
  }

  .hero-rule {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .scroll-arrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    animation: bob 2s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  @media (max-width: 768px) {
    nav {
      padding: 1rem 1.25rem;
    }

    .hero {
      grid-template-columns: 1fr;
    }

    .hero-content {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .hero-title {
      white-space: normal;
      word-break: break-word;
      font-size: clamp(2.5rem, 15vw, 4rem);
    }

    .hero-bottom {
      left: 1.25rem;
      right: 1.25rem;
      bottom: 1.25rem;
    }
  }
</style>
