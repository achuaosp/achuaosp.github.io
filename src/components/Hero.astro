---
import HeroCanvas from './HeroCanvas.astro'
---

<nav data-nav>
  <span class="nav-logo">Achu</span>
  <div class="nav-links">
    <a href="https://github.com/achu" target="_blank" rel="noopener">GitHub</a>
    <a href="https://t.me/achu" target="_blank" rel="noopener">Telegram</a>
  </div>
</nav>

<section class="hero">
  <div class="hero-glow"></div>
  <HeroCanvas />
  <div class="hero-content">
    <h1 class="hero-name" data-hero-title>I'm <span class="accent">Achu</span></h1>
    <p class="hero-tagline" data-hero-tagline>
      ROM developer for violet.<span class="cursor" data-hero-cursor>_</span>
    </p>
  </div>
  <div class="scroll-hint" data-hero-scroll>
    <span>scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2.5rem;
    z-index: 100;
    background: linear-gradient(180deg, var(--bg-primary) 0%, transparent 100%);
  }

  .nav-logo {
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 6vw;
    overflow: hidden;
    z-index: 1;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(124,58,237,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(124,58,237,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    z-index: 0;
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    right: 10%;
    top: 50%;
    transform: translateY(-50%);
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(124,58,237,0.12) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 600px;
  }

  .hero-tagline {
    margin-top: 1.5rem;
    letter-spacing: 0.02em;
  }

  .cursor {
    color: var(--accent);
    animation: blink 1s step-end infinite;
    font-weight: 700;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 6vw;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    z-index: 2;
  }

  .scroll-hint span {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(232,234,240,0.3);
    writing-mode: vertical-rl;
  }

  .scroll-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, rgba(124,58,237,0.8), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(0.6); }
  }

  @media (max-width: 768px) {
    nav {
      padding: 1rem 1.25rem;
    }

    .hero {
      padding: 0 5vw;
    }

    .hero-content {
      max-width: 100%;
    }

    .hero-name {
      white-space: normal;
      word-break: break-word;
    }

    .hero-glow {
      width: 300px;
      height: 300px;
      right: -10%;
      top: 35%;
    }
  }
</style>
