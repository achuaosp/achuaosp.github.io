<section class="projects projects-section" data-projects>
  <canvas id="chip-canvas"></canvas>
  <div class="projects-inner">
    <div class="section-header anim anim-up" data-label="PROJECTS">
      <span class="section-counter mono">[02]</span>
      <h2>Projects</h2>
    </div>
    <div class="cards">
      <article class="project-card anim anim-up anim-d1" data-project-card>
        <div class="badge">Official Maintainer</div>
        <h3 class="card-title">Project <span class="thin">Matrixx</span></h3>
        <p class="card-subtitle">
          Feature-rich AOSP ROM &middot; Material You &middot; Stable monthly
          releases
        </p>
        <div class="card-tags">
          <span>violet</span>
          <span>SM6150</span>
          <span>AOSP</span>
        </div>
        <a href="#" class="card-btn">Download</a>
      </article>

      <article class="project-card anim anim-up anim-d2" data-project-card>
        <div class="card-badge card-badge--alt">Maintained Build</div>
        <h3 class="card-title">Project InfinityX</h3>
        <p class="card-subtitle">
          Customization-first ROM &middot; SM6150-tuned kernel &middot; Daily
          driver
        </p>
        <div class="card-tags">
          <span>violet</span>
          <span>SM6150</span>
          <span>AOSP</span>
        </div>
        <a href="#" class="card-btn">Download</a>
      </article>
    </div>
  </div>
</section>

<script>
import * as THREE from 'three'

const canvas = document.getElementById('chip-canvas')
const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true })
renderer.setSize(400, 400)

const scene = new THREE.Scene()
const camera = new THREE.PerspectiveCamera(60, 1, 0.1, 100)
camera.position.z = 3

const group = new THREE.Group()
for (let i = 0; i < 5; i++) {
  const ringGeo = new THREE.TorusGeometry(0.4 + i * 0.18, 0.012, 8, 80)
  const ringMat = new THREE.MeshStandardMaterial({
    color: i % 2 === 0 ? 0x7c3aed : 0x3b0764,
    metalness: 1,
    roughness: 0.1,
    transparent: true,
    opacity: 0.7 - i * 0.1,
  })
  const ring = new THREE.Mesh(ringGeo, ringMat)
  ring.rotation.x = Math.PI / 2
  ring.userData.speed = 0.3 + i * 0.15
  group.add(ring)
}

scene.add(group)
scene.add(new THREE.AmbientLight(0xffffff, 0.3))
const pl = new THREE.PointLight(0x7c3aed, 3, 6)
pl.position.set(2, 2, 2)
scene.add(pl)

const clock = new THREE.Clock()
function animate() {
  requestAnimationFrame(animate)
  const t = clock.getElapsedTime()
  group.children.forEach((ring, i) => {
    ring.rotation.z = t * ring.userData.speed * (i % 2 === 0 ? 1 : -1)
  })
  group.rotation.x = t * 0.1
  group.rotation.y = t * 0.2
  renderer.render(scene, camera)
}
animate()
</script>

